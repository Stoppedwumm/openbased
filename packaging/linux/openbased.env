# Environment for the OpenBased service. Readable only by root and the openbased group.

# TMDB API key (v3) or read access token (v4) for movie and TV metadata.
TMDB_API_KEY=

# Password for the "admin" account created on first start. If empty, a random one is
# generated and printed once in the log:  sudo journalctl -u openbased | grep password
OPENBASED_ADMIN_PASSWORD=

# JVM options, e.g. a larger heap for big libraries.
JAVA_OPTS=-Xmx1g
